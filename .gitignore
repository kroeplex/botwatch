# Worktrees live here and are never committed. The .dev-docs link inside is the
# one exception, force-added once. See
# https://github.com/kroeplex/dev-docs/blob/main/boilerplate/README.md
/.claude/worktrees/

# Python
__pycache__/
*.py[cod]
.mypy_cache/
.pytest_cache/

# Poetry keeps the virtualenv in-project (see poetry.toml).
/.venv/
